# Copy to ~/.config/claude-agent-setup/env (laptop) and edit. Shell syntax; the environment wins over this file.
AGENT_RULES_HOST=my-vps                      # ssh host the installers write to
AGENT_OVERLAY_DIR=~/private/agent-overlay    # claude-routines/*.conf|*.md|routines.env, routines/jobs, extra bins
NOTIFY_ENV_SRC=/srv/app/.env                 # VPS file with TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID (optional)
# session-brief (optional)
BRIEF_BRAIN_SSH=my-vps
BRIEF_BRAIN_ENV=/etc/brain/hub-http.env      # defines HUB_HTTP_HOST and HUB_HTTP_BRAIN_TOKEN on that host
BRIEF_TAG_ALIASES="widgets-*=widgets"
BRIEF_BASES="task-api=chore/integration"
# agent-dispatch (optional)
ISSUE_REPO=widgets-co/widgets-api
AGENT_DISPATCH_WORKSPACE=/opt/agy-workspace/widgets-api
