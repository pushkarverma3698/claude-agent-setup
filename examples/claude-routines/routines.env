# Optional display names, sourced by claude-routine and routine-verdict. Write - in a name as _.
LABEL_alt="second account"           # how notifications name profile "alt"
TITLE_nightly="Widgets nightly"      # how notifications and verdicts name routine "nightly"
PROJ_nightly=widgets                 # brain project tag for routine "nightly"
REPO_NAME_api=widgets-api            # repo folder for verdict tag "api"
AUTHOR=your-github-login             # routine-verdict: whose PRs count as routine PRs
NOTIFY_TZ=Europe/Amsterdam           # times in notifications (default UTC)
NOTIFY_TZ_LABEL=CET
