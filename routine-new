#!/usr/bin/env bash
#
# routine-new — give a GitHub repo the scheduled VPS routine (2026-10-27, rebuilt on the per-project config 2026-10-31):
# a scheduled Claude run works the project's task tracker (a CSV in its own repo, routines/bin/tracker), builds,
# reviews and merges verified PRs into the repo's integration branch, and a code-only PROD-READY verdict goes to Telegram.
# No GitHub labels: task state lives in the tracker.
#
#   routine-new <owner/repo> <integration-branch> <schedule> [options]
#   routine-new --remove <name>
#
#   <schedule>          space-separated HH:MM times, daily in --tz ("03:04 15:00" = two runs a day, one timer);
#                       anything with a * or - is used as one systemd OnCalendar string (routines/bin/routine-schedule)
#   --name <name>       routine name, project name and verdict group (default: <repo>-daily)
#   --tracker-repo <o/r>  repo holding the tracker CSV (default: <owner/repo>-tracker; created PRIVATE when missing)
#   --tracker-path <p>  the CSV inside it (default: backlog.csv; seeded with a header and one example row when missing)
#   --tz <zone>        zone of the HH:MM times, written as SCHEDULE_TZ (default: $NOTIFY_TZ, else UTC)
#   --profile <list>    accounts, tried round-robin across runs; the first with usage left runs it (default: alt,alt2,main)
#   --model <model>     lead model (default: opus; builders are Sonnet, set in the job file)
#   --verdict-at <T>    verdict time, HH:MM:SS UTC (default: 6 h after the last HH:MM time; required otherwise)
#   --boot-check <name> the CI check that boots the app: the verdict and branch protection require it
#   --no-deploy         write everything, skip setup-claude-routines (the guard policy is still installed)
#   --paused            write PAUSED=1 in the conf: the timer is installed but stopped and disabled, so nothing runs
#                       before the job contract is written (setup-claude-routines arms it once PAUSED=1 is removed)
#   --dry-run           read-only: run every check, print every action it would take and the conf it would write,
#                       write nothing (GitHub, VPS or the conf folder); exit 1 when a real run would stop
#   --allow-unprotected go on when GitHub refuses branch protection (a private repo on a free plan); the guard hook
#                       still refuses merges outside the integration branch, GitHub does not
#
# Task ids must be T-<number> (the tracker's ID_RE default, the feat/t<N>- branch regex, and token-guard's task=T-NNN
# PR-body check `Closes T-<N>` are all fixed to that form). A repo with other ids is not covered: do not onboard it with this.
#
# Steps, each skipping what already exists (it never overwrites a routine):
#   1. gh here and claude-agent's gh on the VPS can write to the code repo
#   2. the code repo has a first commit (an empty repo gets a README) and the integration branch exists (created
#      from the default branch's head if not)
#   3. the tracker repo exists (created private if not), holds the CSV (seeded if not), and claude-agent can write to it
#   4. branch protection on the integration branch when it has none: PRs required (0 approvals; the agent merges
#      as the same account), no force-push, no deletion, plus the boot check when given. A refusal stops the run
#      (re-run is safe) unless --allow-unprotected
#   5. clone in /home/claude-agent/work/<repo> on the VPS
#   6. `tracker migrate`: the agent columns are added to the CSV (checked against a draft conf before anything is written)
#   7. claude-routines/<name>.{conf,md} here (routine keys + tracker keys in the one conf), /home/claude-agent/agent-jobs/<name>.md
#      on the VPS from routine-job-template.md (keeps definition-of-done.md and the routine/review status)
#   8. setup-claude-routines (timers, verdict group, routine-policy --install), then the timers, a dry-run verdict
#      for the group; then the laptop and VPS guard policy must list the repo (it stops if not), and `tracker next`
#      as the last self-check. It ends with the steps left for you (the job contract, the tracker rows).
# --remove deletes the two definition files, re-runs setup-claude-routines (it disables and removes both
# timers) and renames the VPS job file to <name>.md.removed-<date>. The clone and protection stay.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lib/agent-env.sh"
need_host
DEFS="${ROUTINE_CONF_DIR:-${AGENT_OVERLAY_DIR:+$AGENT_OVERLAY_DIR/claude-routines}}"
[ -d "$DEFS" ] || { echo "routine-new: set AGENT_OVERLAY_DIR or ROUTINE_CONF_DIR" >&2; exit 64; }
TEMPLATE="$HERE/routine-job-template.md"
SCHEDULER="$HERE/routines/bin/routine-schedule"
TRACKER="${TRACKER_BIN:-$HERE/routines/bin/tracker}"
HOST=$AGENT_RULES_HOST
JOBS=/home/claude-agent/agent-jobs

die() { echo "routine-new: $*" >&2; exit 1; }
# --dry-run helpers: `would` prints an action a real run takes; `stop` dies in a real run and, in a dry run, records
# the reason and goes on so the whole plan prints. `todo` collects what is left for the founder.
dry=0 stops=0 todo=()
would() { echo "   DRY-RUN would: $*"; }
stop() { if [ $dry = 1 ]; then echo "   WOULD STOP: $*"; stops=$((stops + 1)); else die "$@"; fi; }
usage() { sed -n '8,/^# Steps,/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 64; }
vps() { ssh -o BatchMode=yes "$HOST" "$@"; }
# vps_agent <script> [args]: runs bash as claude-agent on the VPS with the args quoted through ssh
vps_agent() { local s=$1; shift; vps "sudo -n -u claude-agent -H bash -s -- $(printf '%q ' "$@")" <<<"$s"; }
show_state() { # show_state <name>: the routine's timers and its group's dry-run verdict
  echo "== timers"
  vps "systemctl list-timers --all --no-pager | grep -E 'NEXT|claude-routine@$1\.timer|routine-verdict@$1\.timer' || echo '  (no timer for $1)'"
  vps "systemctl show -p TimersCalendar claude-routine@$1.timer 2>/dev/null | sed 's/ ; /\n    /g; s/^/  /' || true"  # one line per time, each with its next run
  echo "== DRY_RUN=1 routine-verdict $1"
  vps "sudo -n -u claude-agent -H env DRY_RUN=1 /usr/local/bin/routine-verdict $1" || echo "  (routine-verdict exit $?)"
}

# ---- --remove ---------------------------------------------------------------------------------------
if [ "${1:-}" = --remove ]; then
  name=${2:-}; [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || usage
  [ -f "$DEFS/$name.conf" ] || die "no routine $name in ${DEFS/#$HOME/~}"
  vps "pgrep -u claude-agent -af '[r]outine: $name( |\$)'" && die "a $name run is live; remove it after the run ends"
  rm -f "$DEFS/$name.conf" "$DEFS/$name.md"; echo "removed ${DEFS/#$HOME/~}/$name.{conf,md}"
  "$HERE/setup-claude-routines"
  vps "sudo -n -u claude-agent -H bash -c '[ -e $JOBS/$name.md ] && mv $JOBS/$name.md $JOBS/$name.md.removed-\$(date +%Y%m%d) && echo renamed $JOBS/$name.md to $name.md.removed-\$(date +%Y%m%d) || true'"
  show_state "$name"
  exit 0
fi

# ---- arguments --------------------------------------------------------------------------------------
[ $# -ge 3 ] || usage
repo=$1 base=$2 sched=$3; shift 3
name="" profile=alt,alt2,main model=opus vat="" boot="" deploy=1 trepo="" tpath=backlog.csv tz="" unprot=0 paused=0
while [ $# -gt 0 ]; do
  case $1 in
    --name) name=${2:?}; shift 2 ;;
    --tracker-repo) trepo=${2:?}; shift 2 ;;
    --tracker-path) tpath=${2:?}; shift 2 ;;
    --tz) tz=${2:?}; shift 2 ;;
    --profile) profile=${2:?}; shift 2 ;;
    --model) model=${2:?}; shift 2 ;;
    --verdict-at) vat=${2:?}; shift 2 ;;
    --boot-check) boot=${2:?}; shift 2 ;;
    --no-deploy) deploy=0; shift ;;
    --paused) paused=1; shift ;;
    --dry-run) dry=1; shift ;;
    --allow-unprotected) unprot=1; shift ;;
    *) usage ;;
  esac
done
[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "repo must be owner/repo, got '$repo'"
[[ "$base" =~ ^[A-Za-z0-9._/-]+$ && "$base" != */ ]] || die "bad integration branch '$base'"
dir=${repo#*/}
slug=$(printf %s "$dir" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//')
[ -n "$name" ] || name="$slug-daily"
[[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ && "$name" != all ]] || die "--name must be a-z, 0-9, - (not all)"
[ -n "$trepo" ] || trepo="$repo-tracker"
[[ "$trepo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--tracker-repo must be owner/repo, got '$trepo'"
[ "$trepo" != "$repo" ] || die "the tracker repo must be a different repo from the code repo (a protected branch refuses the tool's writes)"
[[ "$tpath" =~ ^[A-Za-z0-9_./-]+$ && "$tpath" != /* ]] || die "bad --tracker-path '$tpath'"
[[ "$profile" =~ ^(main|alt|alt2)(,(main|alt|alt2))*$ ]] || die "--profile must be main, alt, alt2 or a comma list"
[[ "$model" =~ ^[a-z0-9.-]+$ ]] || die "bad --model"
[ -f "$SCHEDULER" ] || die "missing $SCHEDULER"
[ -x "$TRACKER" ] || die "missing $TRACKER (routines/bin/tracker; merge the tracker branch first)"
if [[ "$sched" == *'*'* || "$sched" == *-* ]]; then # a systemd calendar string, one OnCalendar line (the pre-2026-10-31 form)
  [ -z "$tz" ] || die "--tz goes with HH:MM times; write the zone inside the calendar string"
  [ -n "$vat" ] || die "--verdict-at HH:MM:SS (UTC) is required with an OnCalendar schedule"
  timeform=0
else
  timeform=1; tz=${tz:-${NOTIFY_TZ:-UTC}}
fi
oncal=$("$SCHEDULER" "$sched" "$tz") || die "bad schedule '$sched'"
if [ $timeform = 1 ] && [ -z "$vat" ]; then # 6 h after the last time of the day, written in UTC: subtract the zone's offset
  last=$(tr ' ' '\n' <<<"$sched" | grep . | sort | tail -1); h=${last%:*} m=${last#*:}
  z=$(TZ=$tz date +%z); off=$(( 10#${z:1:2} * 60 + 10#${z:3:2} )); [ "${z:0:1}" = - ] && off=$(( -off ))
  t=$(( (10#$h * 60 + 10#$m + 360 - off + 2880) % 1440 )); vat=$(printf '%02d:%02d:00' $((t / 60)) $((t % 60)))
fi
[[ "$vat" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$ ]] || die "--verdict-at must be HH:MM:SS (UTC)"
[ -f "$TEMPLATE" ] || die "missing $TEMPLATE"
[ $dry = 0 ] || echo "DRY-RUN: read-only checks run, nothing is written. Every write is printed as 'DRY-RUN would:'."
[ ! -e "$DEFS/$name.conf" ] && [ ! -e "$DEFS/$name.md" ] || stop "routine $name already exists in ${DEFS/#$HOME/~}; edit it there or pick --name"
for c in "$DEFS"/*.conf; do
  [ -e "$c" ] || continue
  g=$(bash -c 'source "$1"; printf %s "${VERDICT:-}"' _ "$c")
  [ "$g" != "$name" ] || stop "verdict group $name is already used by $(basename "$c")"
done
while IFS= read -r l; do
  vps "systemd-analyze calendar '$l' >/dev/null" </dev/null || stop "systemd on the VPS does not accept the schedule line '$l'"
done <<<"$oncal"
vps "sudo -n test ! -e $JOBS/$name.md" || stop "$JOBS/$name.md already exists on the VPS"
echo "routine $name: $repo, integration branch $base, tracker $trepo/$tpath, runs: $(tr '\n' ';' <<<"$oncal" | sed 's/;$//; s/;/; /g'), verdict $vat UTC, accounts $profile"

# ---- 1. access ----------------------------------------------------------------------------------------
write_ok() { case $1 in ADMIN|MAINTAIN|WRITE) return 0;; *) return 1;; esac; }
repo_ok=1
if perm=$(gh repo view "$repo" --json viewerPermission -q .viewerPermission 2>/dev/null); then
  write_ok "$perm" || stop "gh here has $perm on $repo; it needs write"
else
  perm=NONE repo_ok=0; stop "gh here cannot read $repo (create it, or check the name)"
fi
vperm=$(vps_agent 'gh repo view "$1" --json viewerPermission -q .viewerPermission' "$repo" 2>/dev/null) || vperm=NONE
write_ok "$vperm" || stop "claude-agent on the VPS has ${vperm:-NONE} on $repo; it needs write (log in its gh, or add it as a collaborator)"
echo "1. access: here $perm, VPS claude-agent ${vperm:-NONE}"

# ---- 2. first commit and integration branch --------------------------------------------------------------
# A repo with no commit has a default_branch name but no branch behind it: the contents API creates the first commit.
prod=""
[ $repo_ok = 0 ] || prod=$(gh api "repos/$repo" -q .default_branch) || true
if [ -z "$prod" ]; then
  [ $repo_ok = 0 ] || stop "GitHub gave no default branch name for $repo"
  prod=main; would "create README.md in $repo if it is empty, and branch $base from its default branch (assumed $prod)"
else
  if ! gh api "repos/$repo/branches/$prod" --silent 2>/dev/null; then
    [ "$(gh api "repos/$repo/branches" -q length)" = 0 ] || stop "$repo has branches but no $prod: fix its default branch"
    if [ $dry = 1 ]; then would "create the first commit in $repo (README.md) on $prod"
    else
      gh api -X PUT "repos/$repo/contents/README.md" -f message="chore: first commit (routine-new)" \
        -f content="$(printf '# %s\n' "$dir" | base64 | tr -d '\n')" --silent || die "could not create the first commit in $repo"
      echo "2. $repo was empty: created $prod with a README"
    fi
  fi
  if gh api "repos/$repo/branches/$base" --silent 2>/dev/null; then
    echo "2. branch $base exists (default branch: $prod)"
  elif [ $dry = 1 ]; then would "create branch $base in $repo from $prod's head"
  else
    sha=$(gh api "repos/$repo/git/ref/heads/$prod" -q .object.sha)
    gh api -X POST "repos/$repo/git/refs" -f ref="refs/heads/$base" -f sha="$sha" --silent
    echo "2. created $base from $prod (${sha:0:7})"
  fi
fi
[ "$base" != "$prod" ] || echo "   note: the integration branch is the default branch, so merges go straight to $prod"

# ---- 3. tracker repo ---------------------------------------------------------------------------------------
# Private, and unprotected: the tool writes the CSV with the contents API, which a protected branch refuses.
tracker_ok=1
if gh repo view "$trepo" --json name >/dev/null 2>&1; then
  echo "3. tracker repo $trepo exists"
elif [ $dry = 1 ]; then
  tracker_ok=0; would "create the PRIVATE repo $trepo (gh repo create $trepo --private)"
else
  gh repo create "$trepo" --private --description "Task tracker for $repo (routine-new)" >/dev/null || die "could not create $trepo"
  echo "3. created private tracker repo $trepo"
fi
tbranch=main
if [ $tracker_ok = 1 ]; then
  tperm=$(gh repo view "$trepo" --json viewerPermission -q .viewerPermission)
  write_ok "$tperm" || stop "gh here has $tperm on $trepo; it needs write"
  vtperm=$(vps_agent 'gh repo view "$1" --json viewerPermission -q .viewerPermission' "$trepo" 2>/dev/null) || vtperm=NONE
  write_ok "$vtperm" || stop "claude-agent on the VPS has ${vtperm:-NONE} on $trepo; it needs write"
  tbranch=$(gh api "repos/$trepo" -q .default_branch)
fi
if [ $tracker_ok = 1 ] && gh api "repos/$trepo/contents/$tpath" -q .sha >/dev/null 2>&1; then
  echo "   $tpath is in $trepo"
elif [ $dry = 1 ]; then
  would "seed $trepo/$tpath with the header and the example row T-1, then check claude-agent on the VPS can write $trepo"
else
  gh api -X PUT "repos/$trepo/contents/$tpath" -f message="chore: seed the task tracker (routine-new)" \
    -f content="$(printf 'Task ID,Title,Status,Depends on,Milestone\nT-1,Replace this example row with your first task,Not started,,M1\n' | base64 | tr -d '\n')" \
    --silent || die "could not seed $tpath in $trepo"
  echo "   seeded $tpath with a header row and the example row T-1"
fi

# ---- 4. branch protection -------------------------------------------------------------------------------
# A private repo on a free plan cannot have protection: GitHub answers 403 "Upgrade to GitHub Pro" even to the read.
# That stops the run (re-run is safe, every step skips what exists) unless --allow-unprotected.
ghmsg() { # ghmsg <gh output>: GitHub's "message", else the first 160 characters on one line
  local m; m=$(grep -o '"message":"[^"]*"' <<<"$1" | head -1 | cut -d'"' -f4)
  if [ -n "$m" ]; then echo "$m"; else head -c 160 <<<"$1" | tr '\n' ' ' | sed 's/ *$//'; fi
}
unprotected() { # unprotected <why>
  if [ $unprot = 1 ]; then
    echo "4. NOT protected ($1); --allow-unprotected: going on, the guard hook alone keeps merges on $base"
    todo+=("$base of $repo has no branch protection ($1). When the repo is public or on a paid plan: re-run routine-new, or set it in https://github.com/$repo/settings/branches")
  else
    stop "branch $base of $repo is NOT protected ($1). Make the repo public or move it to a paid plan, then re-run; or re-run with --allow-unprotected"
  fi
}
if [ $repo_ok = 0 ]; then
  would "protect $base in $repo (PRs only, 0 approvals, no force-push, no deletion${boot:+, requires $boot})"
elif out=$(gh api "repos/$repo/branches/$base/protection" 2>&1); then
  echo "4. $base already has branch protection; left as is"
  if [ -n "$boot" ] && ! gh api "repos/$repo/branches/$base/protection/required_status_checks" -q '.contexts[]' 2>/dev/null | grep -qxF "$boot"; then
    echo "   it does NOT require $boot"
    todo+=("Make $base require $boot: gh api -X POST repos/$repo/branches/$base/protection/required_status_checks/contexts -f 'contexts[]=$boot'")
  fi
elif grep -q "Branch not protected" <<<"$out"; then
  checks=null; [ -z "$boot" ] || checks=$(jq -cn --arg c "$boot" '{strict: false, contexts: [$c]}')
  body=$(jq -cn --argjson rsc "$checks" '{required_status_checks: $rsc, enforce_admins: false,
    required_pull_request_reviews: {required_approving_review_count: 0}, restrictions: null,
    allow_force_pushes: false, allow_deletions: false}')
  if [ $dry = 1 ]; then would "PUT branch protection on $base: $body"
  elif pout=$(gh api -X PUT "repos/$repo/branches/$base/protection" --input - <<<"$body" 2>&1); then
    echo "4. protected $base: PRs only (0 approvals), no force-push, no deletion${boot:+, requires $boot}"
  else
    unprotected "GitHub refused: $(ghmsg "$pout")"
  fi
else
  unprotected "$(ghmsg "$out")"
fi
if [ -n "$boot" ] && [ $repo_ok = 1 ]; then
  if gh api "repos/$repo/commits/$base/check-runs" -q '.check_runs[].name' 2>/dev/null | grep -qxF "$boot"; then
    echo "   boot check $boot reported on $base"
  else
    echo "   boot check $boot is NOT reported on $base's head yet: the verdict says NO until it runs"
  fi
fi

# ---- 5. clone -------------------------------------------------------------------------------------------
if [ $dry = 1 ]; then
  vps "sudo -n test -d /home/claude-agent/work/$dir/.git" </dev/null && echo "5. clone /home/claude-agent/work/$dir exists" \
    || would "clone https://github.com/$repo.git to $HOST:/home/claude-agent/work/$dir as claude-agent"
else
vps_agent '
d=/home/claude-agent/work/$2
if [ -d "$d/.git" ]; then
  u=$(git -C "$d" remote get-url origin)
  case $u in "https://github.com/$1.git"|"https://github.com/$1"|"git@github.com:$1.git") echo "5. clone $d exists";;
    *) echo "5. $d is a clone of $u, not $1" >&2; exit 1;; esac
else
  [ ! -e "$d" ] || { echo "5. $d exists and is not a git clone" >&2; exit 1; }
  git clone -q "https://github.com/$1.git" "$d" && echo "5. cloned $1 to $d"
fi' "$repo" "$dir" || die "clone step failed"
fi

# ---- 6. the conf, and the tracker's agent columns -----------------------------------------------------------
if [ -n "$boot" ]; then boot_line="\`$boot\` (the verdict requires it)"; else boot_line="none yet: do Step 0"; fi
conf=$(
  echo "# Routine for $repo, written by routine-new on $(date +%F). Job steps: $JOBS/$name.md."
  echo "# One file per project: the routine keys below are read by claude-routine, the tracker keys by routines/bin/tracker."
  echo "PROFILE=$profile"
  echo "REPO=$dir                   # ~claude-agent/work/<REPO>"
  echo "BASE=$base                   # the lead worktree ~/work/wt/<name> is cut from origin/<BASE>"
  echo "SCHEDULE=\"$sched\"   # HH:MM times, one timer slot each; a slot that finds the lead still working skips"
  [ $timeform = 0 ] || echo "SCHEDULE_TZ=$tz               # zone of those times (default UTC)"
  echo "ARGS=(--model $model --effort medium)"
  [ $paused = 0 ] || echo "PAUSED=1                     # timer stopped and disabled; delete this line and run setup-claude-routines to arm it"
  echo "# Code-only verdict after the run (routine-verdict@<VERDICT>.timer)."
  echo "VERDICT=$name"
  echo "VERDICT_AT=$vat              # UTC, daily"
  echo "VERDICT_REPOS=(\"$slug|$repo|$base\")   # tag|owner/repo|bases"
  [ -z "$boot" ] || echo "VERDICT_CHECKS=(\"$repo|$boot\")   # repo|check that must be success (boots the app)"
  echo "# Tracker: the CSV that says who works on what (examples/claude-routines/nightly.conf lists the optional keys)."
  echo "TRACKER_REPO=$trepo"
  echo "TRACKER_PATH=$tpath"
  echo "TRACKER_BRANCH=$tbranch"
  echo "CODE_REPO=$repo"
  echo "WORK_BASE=$base                   # new task branches are cut from it"
  echo "# Guard rules (routine-policy documents the fields): PRs into $base, feat/t<N>-* claimed first (BRANCH_FMT's default)."
  if ROUTINE_CONF_DIR="$DEFS" "$HERE/routine-policy" | jq -e --arg r "$repo" '.repos[$r]' >/dev/null; then
    echo "# GUARD_REPOS: $repo already has guard rules in another conf (one entry per repo)."
  else
    echo "GUARD_REPOS=('$repo|bases=$base|branch=^feat/t(\\d+)-')"
  fi
)
draft=$(mktemp -d)/$name.conf; trap 'rm -rf "$(dirname "$draft")"' EXIT
# The guard policy the confs would produce with this one added: it must parse and list the repo, or nothing is written.
cp "$DEFS"/*.conf "$(dirname "$draft")/" 2>/dev/null || true
printf '%s\n' "$conf" >"$draft"
pout=$(ROUTINE_CONF_DIR="$(dirname "$draft")" "$HERE/routine-policy" 2>&1) || stop "routine-policy refuses the confs with $name.conf added: $pout"
if jq -e --arg r "$repo" '.repos[$r]' <<<"$pout" >/dev/null 2>&1; then
  echo "6. guard policy with $name.conf: $repo -> $(jq -c --arg r "$repo" '.repos[$r]' <<<"$pout")"
else
  stop "the guard policy would not list $repo"
fi
if [ $dry = 1 ]; then
  echo "   conf it would write to ${DEFS/#$HOME/~}/$name.conf:"; sed 's/^/     | /' "$draft"
  would "run tracker migrate --project $name on $trepo/$tpath (adds the agent columns)"
else
  mout=$("$TRACKER" migrate --project "$name" --conf "$draft" 2>&1) || die "tracker migrate failed (nothing written to ${DEFS/#$HOME/~} or the VPS): $mout"
  echo "6. tracker migrate: ${mout:-agent columns present}"
fi

# ---- 7. definition files and job file -------------------------------------------------------------------
job=$(cat "$TEMPLATE")
job=${job//\{\{NAME\}\}/$name}; job=${job//\{\{REPO\}\}/$repo}; job=${job//\{\{DIR\}\}/$dir}
job=${job//\{\{BASE\}\}/$base}; job=${job//\{\{PROD\}\}/$prod}; job=${job//\{\{BOOT_LINE\}\}/$boot_line}
job=${job//\{\{DATE\}\}/$(date +%F)}
! grep -q '{{' <<<"$job" || die "template has an unfilled placeholder: $(grep -o '{{[A-Z_]*}}' <<<"$job" | head -1)"
if [ $dry = 1 ]; then
  would "write $HOST:$JOBS/$name.md ($(wc -l <<<"$job" | tr -d ' ') lines from routine-job-template.md)"
  would "write ${DEFS/#$HOME/~}/$name.conf (above) and ${DEFS/#$HOME/~}/$name.md (the one-line run prompt)"
else
  vps "sudo -n -u claude-agent -H bash -c 'pgrep -u claude-agent -af \"[r]outine: $name( |\$)\" && exit 3; test ! -e $JOBS/$name.md || exit 4; umask 022; cat >$JOBS/$name.md'" <<<"$job" \
    || die "did not write $JOBS/$name.md (exit $?: 3 = a run is live, 4 = it exists)"
  echo "7. wrote $HOST:$JOBS/$name.md"
  cp "$draft" "$DEFS/$name.conf"
  echo "Routine run for $repo. Read $JOBS/$name.md in full and follow it exactly, start to finish. Work autonomously; nobody is awake." >"$DEFS/$name.md"
  echo "   wrote ${DEFS/#$HOME/~}/$name.{conf,md}"
fi

# ---- 8. deploy, guard policy, self-check ----------------------------------------------------------------
LAPTOP_POLICY=$HOME/.claude/hooks/routine-policy.json VPS_POLICY=/opt/agent-rules/hooks/routine-policy.json
if [ $dry = 1 ]; then
  if [ $deploy = 1 ]; then would "run setup-claude-routines (timers claude-routine@$name and routine-verdict@$name, routine-policy --install)"
  else would "run routine-policy --install (--no-deploy: no timers)"; fi
  would "check $LAPTOP_POLICY and $HOST:$VPS_POLICY list $repo, then run tracker next --project $name"
else
  if [ $deploy = 0 ]; then
    echo "8. --no-deploy: timers not armed (run setup-claude-routines for that); installing the guard policy"
    AGENT_RULES_HOST="$HOST" ROUTINE_CONF_DIR="$DEFS" "$HERE/routine-policy" --install || die "routine-policy --install failed: the repo is NOT guarded"
  else
    "$HERE/setup-claude-routines"
    show_state "$name"
  fi
  # The guard (token-guard.py) reads these two files; a repo missing from either is unguarded there.
  grep -qF "\"$repo\": {" "$LAPTOP_POLICY" 2>/dev/null \
    || die "$LAPTOP_POLICY does not list $repo: the laptop does not guard it. Run: ROUTINE_CONF_DIR=$DEFS $HERE/routine-policy --install"
  vps "grep -qF '\"$repo\": {' $VPS_POLICY" </dev/null \
    || die "$HOST:$VPS_POLICY does not list $repo: the VPS does not guard it. Run: ROUTINE_CONF_DIR=$DEFS $HERE/routine-policy --install"
  echo "   guard policy lists $repo on the laptop and on $HOST"
  echo "== tracker next (self-check, conf ${DEFS/#$HOME/~}/$name.conf)"
  nout=$("$TRACKER" next --project "$name" --conf "$DEFS/$name.conf" 2>&1) || die "tracker next failed: $nout"
  printf '%s\n' "$nout" | sed 's/^/  /'
  grep -q '^NEXT ' <<<"$nout" || die "tracker next printed no NEXT line"
fi

# ---- what is left for the founder -------------------------------------------------------------------------
todo=("Write the job contract: the local gate (install + test commands CI runs), services and PR body in $HOST:$JOBS/$name.md: ssh -t $HOST 'sudo -u claude-agent -H \${EDITOR:-nano} $JOBS/$name.md'"
      "Fill the tracker: replace the example row T-1 with real tasks (ids must be T-<number>): https://github.com/$trepo/edit/$tbranch/$tpath"
      ${todo[@]+"${todo[@]}"})
[ $paused = 0 ] || todo+=("Arm the timer: delete PAUSED=1 from ${DEFS/#$HOME/~}/$name.conf, then run $HERE/setup-claude-routines")
echo "== left for you (${#todo[@]})"
i=0; for t in "${todo[@]}"; do i=$((i + 1)); echo "  $i. $t"; done
if [ $dry = 1 ]; then
  echo "DRY-RUN done: nothing written. $stops check(s) would stop a real run."
  [ $stops = 0 ] || exit 1
  exit 0
fi
echo "Done. Runs: $(tr '\n' ';' <<<"$oncal" | sed 's/;$//; s/;/; /g'). Queue work by adding rows to $trepo/$tpath (Task ID, Title, Status, Depends on, Milestone)."
