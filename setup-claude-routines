#!/usr/bin/env bash
#
# setup-claude-routines — scheduled Claude routines and cross-account session handover on
# the VPS named by AGENT_RULES_HOST (2026-10-14). Safe to run alone.
# Idempotent: run it again after adding, changing or deleting a routine.
#
# claude.ai Routines run only in Anthropic's cloud (the form has no Remote Control target), so
# routines that must run on the VPS are ours: a systemd timer starts `claude --bg --remote-control`
# as claude-agent, and the run shows up in that account's Claude app, where it can be steered.
#
#   routines        $AGENT_OVERLAY_DIR/claude-routines/<name>.{conf,md} (ROUTINE_CONF_DIR overrides; examples/
#                   shows the format) -> /etc/claude-routines/ (a deleted definition loses its timer). An optional
#                   `routines.env` there gives Telegram plain names (LABEL_<profile>=…, TITLE_<routine>=…,
#                   PROJ_<routine>=…, REPO_NAME_<verdict tag>=…; `-` in a name written as `_`) and AUTHOR=<github login>
#                   (routine-verdict: whose PRs count).
#     <name>.conf   bash fragment: PROFILE (main|alt|alt2, or a comma list such as alt,alt2,main: the
#                   first account whose usage limit is not hit runs it), REPO (~/work/<REPO>), SCHEDULE
#                   (systemd OnCalendar), ARGS (extra claude flags, e.g. --model haiku --permission-mode dontAsk)
#                   MODE=print (optional): no --bg session. The wrapper runs `claude -p` and sends the
#                   final stdout to Telegram itself, so a read-only routine needs no claude-notify
#                   permission and no model-typed shell command (2026-10-26: a Haiku run wrote
#                   `claude-notify "…" ; echo "exit=$?"`, dontAsk refused the compound command, and the
#                   digest never arrived). The prompt just prints the message.
#                   VERDICT=<group>, VERDICT_AT=HH:MM:SS (UTC), VERDICT_REPOS=("tag|owner/repo|bases" …),
#                   optional VERDICT_CHECKS=("owner/repo|check" …) and VERDICT_QUEUE="<cmd printing READY (n)>":
#                   the code-only routine-verdict group for this routine (routine-new writes them)
#                   GUARD_REPOS=("owner/repo|bases=…|branch=…" …): the PR, claim and dispatch rules token-guard.py
#                   applies to those repos; routine-policy documents the fields and writes routine-policy.json
#     <name>.md     the prompt
#   /usr/local/bin/claude-routine <profile[,profile…]> <repo> <name> <prompt-file> [-- claude flags]
#                   or: claude-routine <name>  (reads /etc/claude-routines/<name>.conf)
#                   fresh worktree routine-<name>-<stamp> off origin, session and Remote Control
#                   name "routine: <name> <date>"; stops and removes the previous run of the same
#                   routine first, so one run per routine stays open in the app
#   /usr/local/bin/claude-handover <session-id> <main|alt|alt2>
#                   continues a session under the other account (transcripts are shared on disk):
#                   `claude --bg --resume` in the session's own directory, named "handover: …".
#                   The id can be the local UUID (or a prefix), session_… from the app URL, or cse_…
#   /usr/local/bin/routine-verdict [<group>|all]   (groups: VERDICT= in the confs)
#                   code-only verdict after the routines (no model): per repo, which routine PRs are PROD-READY
#                   and why each other one is not, from the GitHub API only; sent by claude-notify. Source: the
#                   file next to this script (2026-10-26). Rules and scope are in its header.
#   systemd
#     routine-verdict.service           routine-verdict all (manual: sudo systemctl start routine-verdict)
#     routine-verdict@<group>.timer     one per VERDICT=<group> in the confs, daily at VERDICT_AT UTC
#                                       (e.g. 17:30, a few hours after the routine's run)
#     claude-bgd@<profile>.service      `claude daemon run` in claude.slice: every --bg session
#                                       (routines, handovers) lives here. Without it --bg would start a
#                                       transient daemon inside the timer's unit, killed when it ends.
#     claude-routine@<name>.timer       OnCalendar from SCHEDULE (drop-in), Persistent=true
#     claude-routine@<name>.service     oneshot: claude-routine <name>
#     claude-remote-update.service.d/bgd.conf   nightly: restart a claude-bgd onto the new binary,
#                                       only when no background session runs under it
#
# Usage: setup-claude-routines          (then: verify-agent-setup)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib/agent-env.sh"; need_host
HOST="$AGENT_RULES_HOST"
OVERLAY="${AGENT_OVERLAY_DIR:-}"
DEFS="${ROUTINE_CONF_DIR:-${OVERLAY:+$OVERLAY/claude-routines}}"
[ -n "$DEFS" ] && [ -d "$DEFS" ] || { echo "setup-claude-routines: no routine folder: set AGENT_OVERLAY_DIR or ROUTINE_CONF_DIR" >&2; exit 64; }

echo "== routines: check definitions in ${DEFS/#$HOME/~}"
shopt -s nullglob
vgroups=$(mktemp)
for c in "$DEFS"/*.conf; do
  n=$(basename "$c" .conf)
  [[ "$n" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "bad routine name: $n (a-z, 0-9, -)" >&2; exit 1; }
  [[ -f "$DEFS/$n.md" ]] || { echo "routine $n: missing $n.md" >&2; exit 1; }
  ( set +u; PROFILE=; REPO=; SCHEDULE=; MODE=; ARGS=(); VERDICT=; VERDICT_AT=; VERDICT_REPOS=(); VERDICT_CHECKS=(); source "$c"
    [[ "$PROFILE" =~ ^(main|alt|alt2)(,(main|alt|alt2))*$ ]] || { echo "routine $n: PROFILE must be main, alt, alt2 or a comma list of them" >&2; exit 1; }
    [[ -z "${MODE:-}" || "$MODE" == print ]] || { echo "routine $n: MODE must be empty or print" >&2; exit 1; }
    [[ -n "$REPO" && -n "$SCHEDULE" ]] || { echo "routine $n: REPO and SCHEDULE are required" >&2; exit 1; }
    [ -n "$VERDICT" ] || exit 0
    [[ "$VERDICT" =~ ^[a-z0-9][a-z0-9-]*$ && "$VERDICT" != all ]] || { echo "routine $n: VERDICT must be a-z, 0-9, - (not all)" >&2; exit 1; }
    [[ "$VERDICT_AT" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$ ]] || { echo "routine $n: VERDICT_AT must be HH:MM:SS (UTC)" >&2; exit 1; }
    [ ${#VERDICT_REPOS[@]} -gt 0 ] || { echo "routine $n: VERDICT needs VERDICT_REPOS" >&2; exit 1; }
    for s in "${VERDICT_REPOS[@]}"; do [[ "$s" =~ ^[a-z0-9-]+\|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\|[^|]+$ ]] || { echo "routine $n: VERDICT_REPOS entry '$s' is not tag|owner/repo|bases" >&2; exit 1; }; done
    for s in "${VERDICT_CHECKS[@]}"; do [[ "$s" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\|.+$ ]] || { echo "routine $n: VERDICT_CHECKS entry '$s' is not owner/repo|check" >&2; exit 1; }; done
    echo "$VERDICT" >>"$vgroups" )
  echo "  $n"
done
dup=$(sort "$vgroups" | uniq -d); rm -f "$vgroups"
[ -z "$dup" ] || { echo "VERDICT group used by two routines: $dup" >&2; exit 1; }
shopt -u nullglob

echo "== routines: copy definitions to /etc/claude-routines"
( cd "$DEFS" && shopt -s nullglob && COPYFILE_DISABLE=1 tar --no-xattrs -cf - *.conf *.md $( [ -f routines.env ] && echo routines.env ) ) | ssh "$HOST" 'sudo -n bash -c "
  set -e; rm -rf /etc/claude-routines.new; mkdir -p /etc/claude-routines.new
  tar -xf - -C /etc/claude-routines.new --no-same-owner --no-same-permissions
  chown -R root:root /etc/claude-routines.new; chmod 755 /etc/claude-routines.new; chmod 644 /etc/claude-routines.new/*
  rm -rf /etc/claude-routines; mv /etc/claude-routines.new /etc/claude-routines"'

echo "== routines: claude-notify (Telegram status messages) and its env file"
# claude-notify is a file next to this script; the two Telegram keys are copied (never printed) from
# NOTIFY_ENV_SRC, an env file on the VPS that is only read. Unset: /etc/claude-notify.env is left as it is.
if [ -z "${NOTIFY_ENV_SRC:-}" ]; then echo "  NOTIFY_ENV_SRC unset; /etc/claude-notify.env left as it is"; else
ssh "$HOST" "sudo -n env SRC='$NOTIFY_ENV_SRC' bash -s" <<'ROOT'
set -euo pipefail
src=$SRC; dst=/etc/claude-notify.env
new=$(mktemp); trap 'rm -f "$new"' EXIT
grep -m1 '^TELEGRAM_BOT_TOKEN=' "$src" >"$new" || true
grep -m1 '^TELEGRAM_CHAT_ID=' "$src" >>"$new" || true
if [ "$(wc -l <"$new")" -ne 2 ]; then echo "  WARNING: TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID missing in $src; $dst not written" >&2
elif cmp -s "$new" "$dst" && [ "$(stat -c '%a %U:%G' "$dst")" = "640 root:claude-agent" ]; then echo "  $dst unchanged"
else install -m 0640 -o root -g claude-agent "$new" "$dst"; echo "  wrote $dst (0640 root:claude-agent)"; fi
ROOT
fi

echo "== routines: guard rules from the confs' GUARD_REPOS (routine-policy.json, read by token-guard.py)"
AGENT_RULES_HOST="$HOST" ROUTINE_CONF_DIR="$DEFS" "$HERE/routine-policy" --install

echo "== routines: scripts, units and job files (real files in this folder and the overlay; installed bytes = git bytes)"
# Everything below is copied from files next to this script, then from $AGENT_OVERLAY_DIR/routines (same layout,
# your own jobs, ready-set scripts and extra bins). No script text lives in this one.
#   claude-notify, routine-verdict   -> /usr/local/bin
#   routines/bin/*                   -> /usr/local/bin (claude-profile-env is sourced, so 644)
#   routines/systemd/*               -> /etc/systemd/system
#   routines/jobs/*.md               -> /home/claude-agent/agent-jobs (claude-agent owns them; founder-actions.md
#                                       lives only there: it is runtime state, never copied)
#   routines/ready/*                 -> /home/claude-agent/work (ready-set scripts and their tests)
#   routines/husky/init.sh           -> /home/claude-agent/.config/husky/init.sh (env for repos' pre-push hooks)
stage=$(ssh "$HOST" 'mktemp -d')
( cd "$HERE" && COPYFILE_DISABLE=1 tar --no-xattrs -cf - claude-notify routine-verdict routines ) | ssh "$HOST" "tar -xf - -C '$stage'"
[ -z "$OVERLAY" ] || [ ! -d "$OVERLAY/routines" ] || ( cd "$OVERLAY" && COPYFILE_DISABLE=1 tar --no-xattrs -cf - routines ) | ssh "$HOST" "tar -xf - -C '$stage'"
ssh "$HOST" "sudo -n env STAGE='$stage' bash -s" <<'ROOT'
set -euo pipefail
shopt -s nullglob   # an overlay without jobs/ or ready/ copies none
put() { # put <mode> <dest> <src> [owner]: copies only when the bytes differ
  if cmp -s "$3" "$2"; then return 0; fi
  install -D -m "$1" ${4:+-o "$4" -g "$4"} "$3" "$2"; echo "  wrote $2"
}
put_stdin() { # put_stdin <mode> <dest>, content on stdin
  local tmp; tmp=$(mktemp); cat >"$tmp"; put "$1" "$2" "$tmp"; rm -f "$tmp"
}
r="$STAGE/routines"
put 755 /usr/local/bin/claude-notify "$STAGE/claude-notify"
put 755 /usr/local/bin/routine-verdict "$STAGE/routine-verdict"
for f in "$r"/bin/*; do
  n=$(basename "$f"); m=755; [ "$n" = claude-profile-env ] && m=644
  put "$m" "/usr/local/bin/$n" "$f"
done
for f in "$r"/systemd/*; do
  n=$(basename "$f")
  case "$n" in
    claude-remote-update.service.d-bgd.conf) put 644 /etc/systemd/system/claude-remote-update.service.d/bgd.conf "$f" ;;
    *) put 644 "/etc/systemd/system/$n" "$f" ;;
  esac
done
for f in "$r"/jobs/*.md; do put 644 "/home/claude-agent/agent-jobs/$(basename "$f")" "$f" claude-agent; done
[ ! -f "$r/husky/init.sh" ] || put 644 /home/claude-agent/.config/husky/init.sh "$r/husky/init.sh" claude-agent
for f in "$r"/ready/*.py; do n=$(basename "$f"); m=644; case "$n" in test_*) ;; *) m=755;; esac; put "$m" "/home/claude-agent/work/$n" "$f" claude-agent; done
rm -r "$STAGE"

# A timer whose OnCalendar changes is stopped here; after the reload its stamp is set to now before it starts
# again. With Persistent=true a moved schedule otherwise fires a catch-up run at once (2026-10-26: moving a
# verdict schedule fired its routine-verdict@ timer on re-enable). New timers start the same way.
rearm=()
sched_dropin() { # sched_dropin <timer unit> <OnCalendar>
  local d="/etc/systemd/system/$1.d/schedule.conf" new
  new=$(printf '[Timer]\nOnCalendar=\nOnCalendar=%s' "$2")
  [ "$new" = "$(cat "$d" 2>/dev/null)" ] && return 0
  if systemctl is-active -q "$1"; then systemctl stop "$1"; rearm+=("$1"); fi
  printf '%s\n' "$new" | put_stdin 644 "$d"
}
prune() { # prune <unit prefix> <wanted names> <what>: disable and remove timers whose definition is gone
  local d n
  for d in /etc/systemd/system/"$1"@*.timer.d; do
    [ -d "$d" ] || continue
    n=${d#/etc/systemd/system/$1@}; n=${n%.timer.d}
    case " $2 " in *" $n "*) ;; *)
      systemctl disable --now "$1@$n.timer" >/dev/null 2>&1 || true
      rm -rf "$d"; echo "  removed $3 $n (definition deleted)" ;;
    esac
  done
}

# Schedules: one drop-in per definition; a timer whose definition is gone is disabled and removed.
# Verdict groups come from the same files: VERDICT=<group>, VERDICT_AT=<HH:MM:SS UTC>.
want="" vwant=""
for c in /etc/claude-routines/*.conf; do
  [ -e "$c" ] || continue
  n=$(basename "$c" .conf); want="$want $n"
  sched=$(bash -c 'source "$1"; printf %s "$SCHEDULE"' _ "$c")
  systemd-analyze calendar "$sched" >/dev/null 2>&1 || { echo "  routine $n: bad SCHEDULE '$sched'" >&2; exit 1; }
  sched_dropin "claude-routine@$n.timer" "$sched"
  read -r vg vat < <(bash -c 'source "$1"; printf "%s %s\n" "${VERDICT:-}" "${VERDICT_AT:-}"' _ "$c")
  [ -n "${vg:-}" ] || continue
  vwant="$vwant $vg"
  sched_dropin "routine-verdict@$vg.timer" "*-*-* $vat UTC"
done
prune claude-routine "$want" routine
prune routine-verdict "$vwant" "verdict group"
systemctl daemon-reload
arm() { # arm <timer unit>: enable it; a stopped one starts with its stamp at now, so it cannot fire a catch-up run
  systemctl enable "$1" >/dev/null 2>&1
  systemctl is-active -q "$1" && return 0
  touch "/var/lib/systemd/timers/stamp-$1"; systemctl start "$1"
}
for t in "${rearm[@]}"; do arm "$t"; echo "  $t: schedule changed, re-armed without a catch-up run"; done

# Daemons: a transient daemon (from an ad-hoc `claude --bg`) holds the profile's socket; the service
# starts only when none runs, and never kills a transient one that still has sessions.
for p in main alt alt2; do
  u="claude-bgd@$p.service"
  systemctl enable "$u" >/dev/null 2>&1
  systemctl is-active -q "$u" && { echo "  $u running"; continue; }
  cfg=/home/claude-agent/.claude; [ $p = main ] || cfg=/home/claude-agent/.claude-$p
  t=$(pgrep -u claude-agent -f 'claude daemon run --origin transient' | while read -r pid; do
        e=$(tr '\0' '\n' </proc/$pid/environ 2>/dev/null | sed -n 's/^CLAUDE_CONFIG_DIR=//p'); [ "${e:-/home/claude-agent/.claude}" = "$cfg" ] && echo "$pid"; done || true)
  if [ -n "$t" ]; then
    if pgrep -P "$t" -f -- '--bg-pty-host .*/pty/' >/dev/null; then echo "  DEFERRED $u: transient daemon $t has sessions; re-run when idle"; continue; fi
    kill "$t"; sleep 2
  fi
  systemctl start "$u" && echo "  $u started"
done
for g in $vwant; do
  arm "routine-verdict@$g.timer"
  echo "  routine-verdict@$g.timer next: $(systemctl show -p NextElapseUSecRealtime --value "routine-verdict@$g.timer")"
done
systemctl enable --now claude-routine-resume.timer >/dev/null 2>&1
echo "  claude-routine-resume.timer next: $(systemctl show -p NextElapseUSecRealtime --value claude-routine-resume.timer)"
for n in $want; do
  arm "claude-routine@$n.timer"
  echo "  claude-routine@$n.timer next: $(systemctl show -p NextElapseUSecRealtime --value "claude-routine@$n.timer")"
done
ROOT

echo "setup-claude-routines: done. List: ssh $HOST claude-routine   Run now: ssh $HOST sudo -n systemctl start claude-routine@<name>"
