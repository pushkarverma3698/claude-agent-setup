#!/bin/bash
# Nightly, after claude-remote-update: restart a claude-bgd daemon that runs an older binary, only
# when no background session runs under it. Written by setup-claude-routines; edit it there.
set -uo pipefail
cur=$(readlink -f /home/claude-agent/.local/bin/claude)
for u in $(systemctl list-units 'claude-bgd@*' --state=active --no-legend --plain | awk '{print $1}'); do
  m=$(systemctl show -p MainPID --value "$u"); [ "$m" != 0 ] || continue
  if [ "$(readlink -f /proc/$m/exe)" = "$cur" ]; then echo "$u: current"; continue; fi
  if pgrep -P "$m" -f -- '--bg-pty-host .*/pty/' >/dev/null; then echo "$u: outdated but busy, next night"; continue; fi
  echo "$u: restarting onto $cur"; systemctl restart "$u"
done
