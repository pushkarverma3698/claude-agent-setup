# Written by setup-claude-routines on the founder's laptop; edit it there.
# Reads each routine's tracker: restarts a lead for leftover rows, reports dead runs and blocked rows (routines/bin/routine-sweep).
[Unit]
Description=Sweep Claude routines for leftover tracker rows, dead runs and blocked rows
After=network-online.target claude-bgd@main.service claude-bgd@alt.service claude-bgd@alt2.service

[Service]
Type=oneshot
Slice=claude.slice
User=claude-agent
Environment=HOME=/home/claude-agent
ExecStart=/usr/local/bin/routine-sweep
TimeoutStartSec=20min
