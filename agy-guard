#!/usr/bin/env bash
#
# agy-guard — answer one question: is it safe to review Antigravity's work yet?
# =============================================================================
# Antigravity keeps one SQLite ledger per conversation in
# ~/.gemini/antigravity/conversations/ and a structured JSONL transcript in
# ~/.gemini/antigravity/brain/<id>/.system_generated/logs/transcript_full.jsonl.
#
# Usage:
#   agy-guard                          # default 3-minute quiet window across other conversations
#   agy-guard 10                       # require 10 minutes of silence
#   agy-guard --conv <id> [quiet_sec]  # check a specific conversation (turn complete + quiet_sec, default 5s)
#
# Exit 0 = idle, safe to review.  Exit 1 = still writing, do not review.

set -euo pipefail

readonly LEDGER_DIR="${AGY_LEDGER_DIR:-${HOME}/.gemini/antigravity/conversations}"
readonly BRAIN_DIR="${AGY_BRAIN_DIR:-${HOME}/.gemini/antigravity/brain}"

mtime_epoch() {
  stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null || date +%s
}

check_conv() {
  local conv_id="$1"
  local quiet_sec="${2:-5}"
  local tf="${BRAIN_DIR}/${conv_id}/.system_generated/logs/transcript_full.jsonl"
  [ -f "$tf" ] || tf="${BRAIN_DIR}/${conv_id}/.system_generated/logs/transcript.jsonl"
  local db="${LEDGER_DIR}/${conv_id}.db"

  if [ ! -f "$tf" ] && [ ! -f "$db" ]; then
    echo "agy-guard: IDLE — no ledger or transcript found for ${conv_id}."
    exit 0
  fi

  if [ -f "$tf" ] && command -v jq >/dev/null 2>&1; then
    local last_line state
    last_line=$(grep -v '^[[:space:]]*$' "$tf" 2>/dev/null | tail -1 || true)
    if [ -n "$last_line" ]; then
      state=$(printf '%s\n' "$last_line" | jq -r '
        if (.type == "PLANNER_RESPONSE" and .status == "DONE" and ((.tool_calls // []) | length == 0))
        then "IDLE"
        else "BUSY:\(.type // "unknown")/\(.status // "unknown")"
        end
      ' 2>/dev/null || echo "BUSY:parse_error")
      if [ "$state" != "IDLE" ]; then
        echo "agy-guard: BUSY — conversation ${conv_id} is mid-turn (${state#BUSY:})."
        exit 1
      fi
    fi
  fi

  if [ "$quiet_sec" -gt 0 ]; then
    local now age f
    now=$(date +%s)
    for f in "$tf" "$db"; do
      [ -f "$f" ] || continue
      age=$(( now - $(mtime_epoch "$f") ))
      if [ "$age" -lt "$quiet_sec" ]; then
        echo "agy-guard: BUSY — conversation ${conv_id} was written ${age}s ago (< ${quiet_sec}s quiet window)."
        exit 1
      fi
    done
  fi

  echo "agy-guard: IDLE — conversation ${conv_id} completed its turn and is quiet."
  exit 0
}

if [[ "${1:-}" == "--conv" ]]; then
  conv="${2:-}"
  [[ -n "$conv" ]] || { echo "usage: agy-guard --conv <conversation_id> [quiet_seconds]" >&2; exit 2; }
  check_conv "$conv" "${3:-5}"
fi

readonly QUIET_MINUTES="${1:-3}"

if [[ ! -d "${LEDGER_DIR}" ]]; then
  echo "agy-guard: no ledger directory at ${LEDGER_DIR}"
  echo "           Antigravity has never run on this machine — nothing to wait for."
  exit 0
fi

# Exclude the caller's own conversation ledger if invoked from inside Antigravity.
self_db=""
if [[ -n "${ANTIGRAVITY_CONVERSATION_ID:-}" ]]; then
  self_db="${ANTIGRAVITY_CONVERSATION_ID}.db"
fi

recent=""
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  [[ -n "$self_db" && "$(basename "$f")" == "$self_db" ]] && continue
  recent="${recent:+$recent$'\n'}$f"
done < <(find "${LEDGER_DIR}" -name '*.db' -newermt "-${QUIET_MINUTES} minutes" 2>/dev/null || true)

if [[ -z "${recent}" ]]; then
  echo "agy-guard: IDLE — no conversation ledger written in ${QUIET_MINUTES}m."
  echo "           Safe to review. Commit the tree BEFORE you start reading."
  exit 0
fi

count="$(printf '%s\n' "${recent}" | wc -l | tr -d ' ')"
echo "agy-guard: BUSY — ${count} conversation(s) written in the last ${QUIET_MINUTES}m."
echo
while IFS= read -r ledger; do
  printf '  %s  %s\n' "$(stat -f '%Sm' -t '%H:%M:%S' "${ledger}" 2>/dev/null || stat -c '%y' "${ledger}" 2>/dev/null)" "$(basename "${ledger}")"
done <<< "${recent}"
echo
echo "  DO NOT review or edit the working tree yet. A live conversation can still"
echo "  revert its own work — that is exactly how AG-004 erased 140 reviewed lines"
echo "  nine minutes after reporting done."
echo
echo "  Wait for silence, or close the conversation in the Antigravity GUI."
exit 1
