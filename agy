#!/bin/sh
# agy — dispatch/track/loop wrapper around Google Antigravity's agentapi.
#
# Local dev tool only. Antigravity's language_server binds its gRPC address
# to an ephemeral port and mints a fresh CSRF token on every restart, so both
# are rediscovered on every call rather than cached. Requires Antigravity.app
# to be running (agentapi is a thin client to its language_server process).

set -eu

AGENTAPI="${AGY_AGENTAPI_BIN:-$HOME/.gemini/antigravity/bin/agentapi}"
BRAIN_DIR="${AGY_BRAIN_DIR:-$HOME/.gemini/antigravity/brain}"
LEDGER_DIR="${AGY_LEDGER_DIR:-$HOME/.gemini/antigravity/conversations}"
PROJECTS_DIR="${AGY_PROJECTS_DIR:-$HOME/.gemini/config/projects}"
LS_MATCH="Antigravity.app/Contents/Resources/bin/language_server"

die() {
  echo "agy: $*" >&2
  exit 1
}

find_pid() {
  p=$(pgrep -f "$LS_MATCH" 2>/dev/null | head -1 || true)
  if [ -z "$p" ]; then
    p=$(ps aux | grep -i "$LS_MATCH" | grep -v grep | awk '{print $2}' | head -1 || true)
  fi
  echo "$p"
}

find_csrf() {
  ps -o command= -p "$1" | sed -n 's/.*--csrf_token \([^ ]*\).*/\1/p'
}

find_port() {
  pid="$1"
  csrf="$2"
  ports=$(lsof -nP -a -p "$pid" -iTCP -sTCP:LISTEN 2>/dev/null | tail -n +2 | awk '{print $9}' | sed 's/.*://' | sort -un)
  [ -n "$ports" ] || die "no listening ports found on language_server pid $pid"

  tmp=$(mktemp -d)
  for p in $ports; do
    (ANTIGRAVITY_LS_ADDRESS="127.0.0.1:$p" ANTIGRAVITY_CSRF_TOKEN="$csrf" \
      "$AGENTAPI" get-conversation-metadata agy-port-probe >"$tmp/$p.log" 2>&1) &
  done
  wait

  found=""
  for p in $ports; do
    if [ -f "$tmp/$p.log" ] && ! grep -q "connection error" "$tmp/$p.log"; then
      found="$p"
      break
    fi
  done
  rm -rf "$tmp"
  [ -n "$found" ] || die "no port on pid $pid answered the Antigravity RPC protocol (is Antigravity still starting up?)"
  echo "$found"
}

resolve_project_id() {
  explicit="${1:-${AGY_PROJECT_ID:-${ANTIGRAVITY_PROJECT_ID:-}}}"
  if [ -n "$explicit" ] && [ -d "$PROJECTS_DIR" ]; then
    # Allow either a UUID or a project name in ~/.gemini/config/projects/*.json
    by_name=$(jq -rs --arg q "$explicit" '.[] | select(.id == $q or .name == $q) | .id' "$PROJECTS_DIR"/*.json 2>/dev/null | head -1 || true)
    if [ -n "$by_name" ]; then
      echo "$by_name"
      return 0
    fi
  fi
  if [ -n "$explicit" ]; then
    echo "$explicit"
    return 0
  fi
  if [ ! -d "$PROJECTS_DIR" ]; then
    echo ""
    return 0
  fi
  common_git=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  repo_root="$PWD"
  if [ -n "$common_git" ]; then
    repo_root="${common_git%/.git}"
  fi
  resolved=$(jq -rs --arg uri "file://$repo_root" --arg name "$(basename "$repo_root")" '
    [
      .[] |
      ((.projectResources.resources // []) | map(.gitFolder.folderUri // .folderUri // empty) | .[0] // "") as $p_uri |
      if ($p_uri != "" and $p_uri == $uri) then {id: .id, score: 1000}
      elif (.name == $name) then {id: .id, score: 900}
      elif ($p_uri != "" and ($uri | startswith($p_uri + "/"))) then {id: .id, score: ($p_uri | length)}
      else empty end
    ] | sort_by(-.score) | .[0].id // empty
  ' "$PROJECTS_DIR"/*.json 2>/dev/null || true)
  if [ -z "$resolved" ]; then
    resolved="outside-of-project"
  fi
  echo "$resolved"
}

resolve() {
  proj_override="${1:-}"
  resolved_pid=$(resolve_project_id "$proj_override")
  # Scrub caller conversation/source metadata so cross-project or external calls never fail
  # with "source project_id does not match target project_id".
  unset ANTIGRAVITY_SOURCE_METADATA ANTIGRAVITY_CONVERSATION_ID ANTIGRAVITY_TRAJECTORY_ID ANTIGRAVITY_AGENT || true
  if [ -n "$resolved_pid" ]; then
    export ANTIGRAVITY_PROJECT_ID="$resolved_pid"
  fi
  if [ "${AGY_SKIP_LS_PROBE:-0}" = "1" ]; then
    export ANTIGRAVITY_LS_ADDRESS="${ANTIGRAVITY_LS_ADDRESS:-127.0.0.1:0}"
    export ANTIGRAVITY_CSRF_TOKEN="${ANTIGRAVITY_CSRF_TOKEN:-test-csrf}"
    return 0
  fi
  pid=$(find_pid || true)
  [ -n "$pid" ] || die "Antigravity is not running (no language_server process found). Launch Antigravity.app first."
  csrf=$(find_csrf "$pid")
  [ -n "$csrf" ] || die "could not read --csrf_token from language_server process args (pid $pid)"
  port=$(find_port "$pid" "$csrf")
  export ANTIGRAVITY_LS_ADDRESS="127.0.0.1:$port"
  export ANTIGRAVITY_CSRF_TOKEN="$csrf"
}

transcript_file() {
  conv_id="$1"
  tf="$BRAIN_DIR/$conv_id/.system_generated/logs/transcript_full.jsonl"
  if [ -f "$tf" ]; then
    echo "$tf"
  else
    echo "$BRAIN_DIR/$conv_id/.system_generated/logs/transcript.jsonl"
  fi
}

max_step_index() {
  tf=$(transcript_file "$1")
  if [ ! -f "$tf" ]; then
    echo "-1"
    return 0
  fi
  last=$(grep -v '^[[:space:]]*$' "$tf" 2>/dev/null | tail -1 || true)
  if [ -z "$last" ]; then
    echo "-1"
    return 0
  fi
  printf '%s\n' "$last" | jq -r '.step_index // -1' 2>/dev/null || echo "-1"
}

cmd_reply() {
  conv_id="${1:-}"
  [ -n "$conv_id" ] || die "usage: agy reply <conversation_id>"
  tf=$(transcript_file "$conv_id")
  [ -f "$tf" ] || die "no transcript found for conversation $conv_id at $tf"
  last=$(grep -v '^[[:space:]]*$' "$tf" 2>/dev/null | tail -1 || true)
  [ -n "$last" ] || die "transcript for conversation $conv_id is empty"
  is_done=$(printf '%s\n' "$last" | jq -r '
    if (.type == "PLANNER_RESPONSE" and .status == "DONE" and ((.tool_calls // []) | length == 0) and (.content != null and .content != ""))
    then "yes"
    else "no"
    end
  ' 2>/dev/null || echo "no")
  if [ "$is_done" != "yes" ]; then
    echo "agy: conversation $conv_id is still mid-turn (use 'agy wait $conv_id')" >&2
    exit 2
  fi
  printf '%s\n' "$last" | jq -r '.content'
}

cmd_wait() {
  timeout_sec=1800
  settle_sec=3
  after_step=-1
  conv_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout=*) timeout_sec="${1#--timeout=}"; shift ;;
      --settle=*) settle_sec="${1#--settle=}"; shift ;;
      --after-step=*) after_step="${1#--after-step=}"; shift ;;
      -*) die "unknown wait option: $1" ;;
      *) conv_id="$1"; shift ;;
    esac
  done
  [ -n "$conv_id" ] || die "usage: agy wait [--timeout=1800] [--settle=3] [--after-step=-1] <conversation_id>"

  start_ts=$(date +%s)
  poll_sec=2
  if [ "$settle_sec" -le 1 ]; then
    poll_sec=1
  fi

  while :; do
    tf=$(transcript_file "$conv_id")
    if [ -f "$tf" ]; then
      last=$(grep -v '^[[:space:]]*$' "$tf" 2>/dev/null | tail -1 || true)
      if [ -n "$last" ]; then
        cand_idx=$(printf '%s\n' "$last" | jq -r --argjson after "$after_step" '
          if (.type == "PLANNER_RESPONSE" and .status == "DONE" and ((.tool_calls // []) | length == 0) and (.content != null and .content != "") and ((.step_index // 0) > $after))
          then (.step_index // 0)
          else -1
          end
        ' 2>/dev/null || echo "-1")
        if [ "$cand_idx" -ge 0 ]; then
          sleep "$settle_sec"
          last_after=$(grep -v '^[[:space:]]*$' "$tf" 2>/dev/null | tail -1 || true)
          idx_after=$(printf '%s\n' "$last_after" | jq -r '.step_index // -2' 2>/dev/null || echo "-2")
          if [ "$idx_after" = "$cand_idx" ]; then
            printf '%s\n' "$last_after" | jq -r '.content'
            return 0
          fi
        fi
      fi
    fi
    now_ts=$(date +%s)
    if [ $((now_ts - start_ts)) -ge "$timeout_sec" ]; then
      echo "agy: timed out after ${timeout_sec}s waiting for conversation $conv_id" >&2
      exit 124
    fi
    sleep "$poll_sec"
  done
}

usage() {
  cat <<'EOF'
agy — dispatch and loop tasks with Google Antigravity from the terminal

Usage:
  agy new [--wait] [--timeout=1800] [--project=<id|name>] [--model=pro|flash|flash_lite] [--title=<title>] "<brief>"
  agy send [--wait] [--timeout=1200] [--title=<title>] <conversation_id> "<message>"
  agy wait [--timeout=1800] [--settle=3] [--after-step=-1] <conversation_id>
  agy reply <conversation_id>               # print completed turn's final message from transcript
  agy status <conversation_id>              # conversation metadata (state, timestamps, projectId)
  agy steps <conversation_id>               # step index/type/status from the local ledger
  agy raw <agentapi-subcommand> [args...]   # escape hatch — any agentapi call, address+token pre-resolved

Address, CSRF token, and projectId are rediscovered on every call.
Use --wait on `new` and `send` to block until the turn settles and print the close-out report.
EOF
}

cmd_steps() {
  conv_id="${1:-}"
  [ -n "$conv_id" ] || die "usage: agy steps <conversation_id>"
  db="$LEDGER_DIR/$conv_id.db"
  [ -f "$db" ] || die "no local ledger for conversation $conv_id at $db"
  command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 not found on PATH"
  sqlite3 -header -column "$db" "select idx, step_type, status from steps order by idx;"
}

[ $# -ge 1 ] || {
  usage
  exit 1
}
sub="$1"
shift

case "$sub" in
  new)
    do_wait=0
    wait_timeout=1800
    wait_settle=3
    proj_arg=""
    for arg in "$@"; do
      case "$arg" in
        --wait) do_wait=1 ;;
        --timeout=*) wait_timeout="${arg#--timeout=}" ;;
        --settle=*) wait_settle="${arg#--settle=}" ;;
        --project=*) proj_arg="${arg#--project=}" ;;
      esac
    done

    if [ "${AGY_ALLOW_PARALLEL:-0}" != 1 ]; then
      guard="$(dirname "$0")/agy-guard"
      if [ -x "$guard" ] && ! "$guard" >/dev/null 2>&1; then
        die "another Antigravity conversation is still writing (agy-guard says not idle). Wait, or AGY_ALLOW_PARALLEL=1 if that is intended."
      fi
      for arg in "$@"; do
        for n in $(printf '%s' "$arg" | grep -o '#[0-9][0-9]*' | tr -d '#' | sort -un); do
          if git ls-remote --heads origin "task/issue-$n" "task/issue-$n-*" 2>/dev/null | grep -q .; then
            die "issue #$n already has a task/issue-$n branch on origin: one agent per issue. AGY_ALLOW_PARALLEL=1 overrides."
          fi
        done
      done
    fi

    resolve "$proj_arg"

    # Strip agy-only flags before calling agentapi new-conversation
    set -- "$@"
    clean_args=""
    # Rebuild positional parameters without --wait, --timeout=*, --settle=*, --project=*
    i=1
    total=$#
    while [ "$i" -le "$total" ]; do
      a="$1"
      shift
      case "$a" in
        --wait|--timeout=*|--settle=*|--project=*) ;;
        *) set -- "$@" "$a" ;;
      esac
      i=$((i + 1))
    done

    out=$("$AGENTAPI" new-conversation "$@")
    err_msg=$(printf '%s\n' "$out" | jq -r '.error // empty' 2>/dev/null || true)
    conv_id=$(printf '%s\n' "$out" | jq -r '.response.newConversation.conversationId // empty' 2>/dev/null || true)
    if [ -n "$err_msg" ] || [ -z "$conv_id" ]; then
      printf '%s\n' "$out" >&2
      die "new-conversation failed${err_msg:+: $err_msg}"
    fi

    if [ "$do_wait" -eq 1 ]; then
      echo "CONVERSATION_ID=$conv_id"
      cmd_wait --timeout="$wait_timeout" --settle="$wait_settle" --after-step=0 "$conv_id"
    else
      printf '%s\n' "$out"
    fi
    ;;
  send)
    do_wait=0
    wait_timeout=1200
    wait_settle=3
    i=1
    total=$#
    while [ "$i" -le "$total" ]; do
      a="$1"
      shift
      case "$a" in
        --wait) do_wait=1 ;;
        --timeout=*) wait_timeout="${a#--timeout=}" ;;
        --settle=*) wait_settle="${a#--settle=}" ;;
        *) set -- "$@" "$a" ;;
      esac
      i=$((i + 1))
    done

    target_conv=""
    for a in "$@"; do
      case "$a" in
        -*) ;;
        *) target_conv="$a"; break ;;
      esac
    done
    [ -n "$target_conv" ] || die "usage: agy send [--wait] [--timeout=1200] <conversation_id> \"<message>\""

    prev_step=$(max_step_index "$target_conv")
    resolve ""
    # Try resolving projectId from target conversation metadata so cross-project send always matches
    meta_pid=$("$AGENTAPI" get-conversation-metadata "$target_conv" 2>/dev/null | jq -r '.response.conversationMetadata.metadata.projectId // empty' 2>/dev/null || true)
    if [ -n "$meta_pid" ]; then
      export ANTIGRAVITY_PROJECT_ID="$meta_pid"
    fi

    out=$("$AGENTAPI" send-message "$@")
    err_msg=$(printf '%s\n' "$out" | jq -r '.error // empty' 2>/dev/null || true)
    if [ -n "$err_msg" ]; then
      printf '%s\n' "$out" >&2
      die "send-message failed: $err_msg"
    fi

    if [ "$do_wait" -eq 1 ]; then
      cmd_wait --timeout="$wait_timeout" --settle="$wait_settle" --after-step="$prev_step" "$target_conv"
    else
      printf '%s\n' "$out"
    fi
    ;;
  wait)
    cmd_wait "$@"
    ;;
  reply)
    cmd_reply "$@"
    ;;
  status)
    resolve ""
    "$AGENTAPI" get-conversation-metadata "$@"
    ;;
  steps)
    cmd_steps "$@"
    ;;
  raw)
    resolve ""
    "$AGENTAPI" "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
